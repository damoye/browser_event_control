{
  "manifest_version": 3,
  "name": "Event Controller",
  "version": "1.0.0",
  "description": "一键屏蔽页面的 blur / visibilitychange 等事件监听器，屏蔽列表可配置",
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html", "default_title": "Event Controller" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["block.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
